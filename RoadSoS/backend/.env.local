# ─── Server ───────────────────────────────────────────────────────────
PORT=5000
JWT_SECRET=your_jwt_secret_here

# ─── Firebase Admin SDK ──────────────────────────────────────────────
# Option 1: Path to your downloaded service account JSON file
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Option 2: Individual credential fields (use if not using a JSON file)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Twilio (SMS alerts) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
